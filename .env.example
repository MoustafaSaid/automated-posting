# Copy this file to .env and fill in the platforms you want to publish to.
# Every value is optional. A platform with no credentials is reported as
# "failed" with a "not configured" error while the other platforms still run.

# Mastodon (e.g. https://mastodon.social)
MASTODON_BASE_URL=
MASTODON_ACCESS_TOKEN=

# Telegram bot + channel/group id (e.g. @my_channel or -1001234567890)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Discord channel webhook URL
DISCORD_WEBHOOK_URL=

# Bluesky (use an App Password, not your main password)
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=
BLUESKY_PDS_URL=https://bsky.social

# DEV.to API key
DEVTO_API_KEY=
